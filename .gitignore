# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
ENV/
env/

# Local data snapshots and caches — keep data/ tracked so Fly.io gets CSVs
# data/

# Uploaded screenshots used for player-signal extraction (potentially personal screenshots)
data/player_signal_images/
# Generated signals store — rebuilt from uploads, no need to commit
data/player_signals.json
# Atomic-write tmp files orphaned by SIGTERM mid-write (see _save_json)
data/*.tmp

# Date-stamped runtime artifacts — regenerated at runtime, not deploy inputs
# (see CLAUDE.md "Data persistence"). The static reference CSVs stay tracked.
data/lineups_*.json
data/umpires_*.json
data/mlb_matchups_*.csv
# Smart-Consensus per-model Brier — derived from the graded tracker at runtime;
# production learns its own, so a dev-generated copy must not be committed.
data/model_accuracies.json
